SPREADSHEET_ID=1vlt8wg7mzFU9b-FHznfKSzptcDLUfqPsColzc6rthgA
SHEET_NAME=facebook_autopost
SHEET_ID=1421564912
TIMEZONE=Asia/Bangkok
MAX_ROWS=11000
MEDIA_DIR=./data/media
DATA_DIR=./data
ACCOUNT_CONFIG_FILE=./accounts.json

# oauth: เหมาะกับบัญชี Google ของผู้ใช้ และทำงานต่อเนื่องด้วย refresh token
# service_account: ต้องแชร์ Google Sheet ให้ email ของ service account ก่อน
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_FILE=./secrets/google-oauth-client.json
GOOGLE_TOKEN_FILE=./secrets/google-token.json
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json

# ต้องเปลี่ยนเป็น true หลังทดสอบ login และ `npm run dry-run` ผ่านแล้วเท่านั้น
PUBLISH_ENABLED=false
CHROME_CHANNEL=chrome
FACEBOOK_HEADLESS=false
FACEBOOK_NAVIGATION_TIMEOUT_MS=60000
FACEBOOK_UPLOAD_TIMEOUT_MS=180000

# ถ้า Local Media Path ในชีตชี้ไปที่ path ภายนอก (เช่น network share) และไฟล์มีขนาด
# ไม่เกินนี้ (MB) โปรแกรมจะใช้ไฟล์จาก path นั้นตรงๆ ถ้าใหญ่กว่านี้จะ copy เข้าเครื่องก่อน
LARGE_MEDIA_THRESHOLD_MB=100

